# -------------------------
# Static Triage Project
# -------------------------

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
ENV/
env/
pip-wheel-metadata/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# -------------------------
# Project runtime artifacts (do NOT commit)
# -------------------------

# PyInstaller
/build/
/dist/
*.spec

# Optional large tool bundles (install separately)
tools/ghidra_12.0_PUBLIC/
tools/capa-rules/

# Tools installed into the VM by bootstrap_tools.ps1, not tracked here
tools/procdump64.exe
tools/procdump.exe
tools/fakenet/
tools/sysmonconfig.xml

# Process memory dumps. These contain the sample's unpacked payload verbatim,
# so a stray commit publishes live malware.
*.dmp

# Malware samples (keep out of git)
samples/

# **Corpora belong on the artifact drive, not here.** `samples/` above only
# catches a directory named exactly that, so `malware-corpus/` -- which is the
# default `--out` of scripts/malware_corpus.py -- was not covered, and a
# `git add -A` would have published live malware to a remote. The corpus is
# meant to live at G:\malware-corpus, outside this tree entirely; these
# patterns exist so that doing it the wrong way still fails safe.
malware-corpus/
*-corpus/

# XOR-wrapped payloads (see dotnet_meta.XOR_SUFFIX). Wrapped so an on-access
# scanner cannot match them on content, which is not a reason to commit them:
# the key is nine bytes and in the source.
*.xor9

# Case outputs / reports / extracted payloads (huge + can include samples)
cases/
build/
dist/
reports/

# Logs (can include sensitive paths/hashes)
logs/

# Common generated outputs
*.log
*.pdf
*.html

# If you want to keep a blank logs folder, remove the logs/ lines above and use:
# logs/*.log
# logs/*.jsonl
# logs/*.json

# -------------------------
# Build / packaging
# -------------------------
build/
dist/
*.zip
*.tar
*.tar.gz

# -------------------------
# Release/Build Artifacts
# -------------------------
Static_Triage_GUI_Release/
scripts/Static_Triage_GUI_Release/
dist/
build/
release/
*.zip
*.7z
*.rar
*.msi
*.spec
# ...except this one. `ringforge.spec` is not generated: it carries the
# one-dir layout, the bundled data, the metadata provenance reads back and
# the build-time identity stamp. The release workflow builds from it.
!ringforge.spec
scripts/static_triage_gui_v2.py
scripts/static_triage_gui_v3.py
scripts/static_triage_gui_v4.py
scripts/static_triage_gui_v5.py
scripts/static_triage_gui_v6.py
scripts/static_triage_gui_v7.py
scripts/static_triage_gui_v8.py
scripts/static_triage_gui_v9.py

# local runtime/config
config.json

# backups
*.bak

# -------------------------
# Optional: if you add local config secrets later
# -------------------------
*.env
.env
config.local.*
secrets.*

# --------------------------
# Optional large tool bundles (install separately)
# --------------------------
tools/ghidra_12.0_PUBLIC/
tools/capa-rules/
tools/Procmon.exe
tools/Procmon64.exe
*.pml
*.pmc

# ---------------------------
# Local third-party tools
# ---------------------------
tools/*.exe
tools/*.chm
tools/*.txt

# The Procmon configs used to need re-including here. They ship with the
# package now -- ringforge/_data/procmon-configs/ -- which is not under an
# excluded parent, so nothing has to be rescued back in.

# ----------------------------
# YARA rules
# ----------------------------
# The downloaded ruleset is hundreds of files installed by
# bootstrap_yara_rules.ps1, and the quarantine holds whatever failed to compile.
# Neither belongs in git. The hand-maintained rules moved to
# ringforge/_data/yara/local/ so that they reach an installed wheel, which
# leaves tools/yara/ holding nothing tracked at all.
tools/yara/rules/
tools/yara/_broken/

# Local release packages
release/


# ----------------------------
# Claude Code
# ----------------------------
# `.claude/settings.json` is shared project config and IS tracked. The local
# file is per-machine -- it accumulates absolute scratchpad paths, including
# ones from other projects entirely -- so it stays out.
.claude/settings.local.json

# Packaging output (`python -m build`). `dist/` is already above.
*.egg-info/

# PyInstaller build output and the identity it stamps in.
build/
ringforge/_build_info.py

# Tool payloads fetched by bootstrap_tools.ps1 or the release workflow.
# capa is 35 MB; neither belongs in git. The licence files come with them.
tools/capa/capa.exe
tools/capa/LICENSE.txt
tools/floss/LICENSE.txt
tools/VENDORED.txt
